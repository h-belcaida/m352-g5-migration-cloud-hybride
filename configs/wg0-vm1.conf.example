# WireGuard sur VM1 (serveur). Copier en /etc/wireguard/wg0.conf et remplacer les valeurs.
# VM1_PUBLIC_IP : <VM1_PUBLIC_IP> (à donner au client OPNsense comme Endpoint)
[Interface]
Address = 10.99.0.1/24
ListenPort = 51820
PrivateKey = <PRIVATE_KEY>

[Peer]
# OPNsense (site on-premise)
PublicKey = <PUBLIC_KEY>
AllowedIPs = 10.99.0.2/32, 192.168.20.0/24
